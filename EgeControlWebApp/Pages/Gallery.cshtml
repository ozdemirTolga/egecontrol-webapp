@page
@model EgeControlWebApp.Pages.GalleryModel
@{
    ViewData["Title"] = "Galeri - Çalışmalarımız";
    ViewData["MetaDescription"] = "Ege Otomasyon proje galerisi. Tamamlanan endüstriyel otomasyon projeleri, PLC pano montajları, SCADA ekranları ve robotik çözümlerimizi inceleyin.";
}

<style>
    .gallery-hero {
        background: linear-gradient(135deg, var(--primary, #2563eb) 0%, var(--accent, #06b6d4) 100%);
        color: white;
        padding: 3rem 0;
        margin: -1rem -0.75rem 2rem;
        text-align: center;
        border-radius: 0 0 2rem 2rem;
    }
    .gallery-hero h1 { font-weight: 800; font-size: 2.5rem; }
    .gallery-hero p { font-size: 1.15rem; opacity: 0.9; max-width: 600px; margin: 0 auto; }

    .gallery-filters { margin-bottom: 1.5rem; }
    .gallery-filters .btn { border-radius: 50px; margin: 0.25rem; }
    .gallery-filters .btn.active { box-shadow: 0 4px 15px rgba(37,99,235,0.3); }

    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.25rem; }
    @@media (max-width: 576px) { .gallery-grid { grid-template-columns: 1fr; } }

    .gallery-card {
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
        background: white;
    }
    .gallery-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 40px rgba(0,0,0,0.15);
    }
    .gallery-card .media-wrap {
        position: relative;
        overflow: hidden;
        aspect-ratio: 4/3;
        background: #f0f0f0;
    }
    .gallery-card .media-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }
    .gallery-card:hover .media-wrap img { transform: scale(1.05); }
    .gallery-card .media-wrap video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .gallery-card .video-badge {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        background: rgba(220,38,38,0.9);
        color: white;
        padding: 0.25rem 0.6rem;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .gallery-card .card-info {
        padding: 1rem;
    }
    .gallery-card .card-info h5 {
        font-weight: 700;
        margin-bottom: 0.25rem;
        font-size: 1rem;
    }
    .gallery-card .card-info p {
        color: #6b7280;
        font-size: 0.875rem;
        margin: 0;
    }
    .gallery-card .card-info .badge {
        font-weight: 500;
        font-size: 0.75rem;
    }

    /* Lightbox */
    .lightbox-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0,0,0,0.92);
        z-index: 9999;
        justify-content: center;
        align-items: center;
        padding: 1rem;
    }
    .lightbox-overlay.active { display: flex; }
    .lightbox-content {
        max-width: 90vw;
        max-height: 90vh;
        position: relative;
    }
    .lightbox-content img, .lightbox-content video {
        max-width: 90vw;
        max-height: 85vh;
        border-radius: 0.75rem;
        box-shadow: 0 20px 60px rgba(0,0,0,0.5);
    }
    .lightbox-close {
        position: absolute;
        top: -2.5rem;
        right: 0;
        background: none;
        border: none;
        color: white;
        font-size: 2rem;
        cursor: pointer;
        opacity: 0.8;
    }
    .lightbox-close:hover { opacity: 1; }
    .lightbox-caption {
        color: white;
        text-align: center;
        margin-top: 1rem;
        font-size: 1.1rem;
        font-weight: 500;
    }
    .lightbox-nav {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.15);
        border: none;
        color: white;
        font-size: 2rem;
        padding: 0.5rem 1rem;
        cursor: pointer;
        border-radius: 0.5rem;
        transition: background 0.2s;
    }
    .lightbox-nav:hover { background: rgba(255,255,255,0.3); }
    .lightbox-prev { left: 1rem; }
    .lightbox-next { right: 1rem; }
</style>

<div class="gallery-hero">
    <h1><i class="fas fa-images me-2"></i>Çalışmalarımız</h1>
    <p>Endüstriyel otomasyon projelerimizden görüntüler</p>
</div>

@if (Model.Categories.Any())
{
    <div class="gallery-filters text-center">
        <button class="btn btn-primary active" data-filter="all">Tümü</button>
        @foreach (var cat in Model.Categories)
        {
            <button class="btn btn-outline-primary" data-filter="@cat">@cat</button>
        }
    </div>
}

<div class="gallery-grid" id="galleryGrid">
    @foreach (var item in Model.Items)
    {
        <div class="gallery-card" data-category="@item.Category" data-type="@item.MediaType"
             data-src="/gallery/@item.FileName" data-title="@item.Title" data-desc="@item.Description">
            <div class="media-wrap">
                @if (item.MediaType == "video")
                {
                    <video preload="metadata" muted playsinline>
                        <source src="~/gallery/@item.FileName" />
                    </video>
                    <span class="video-badge"><i class="fas fa-play me-1"></i>Video</span>
                }
                else
                {
                    <img src="~/gallery/@item.FileName" alt="@item.Title" loading="lazy" />
                }
            </div>
            <div class="card-info">
                <h5>@item.Title</h5>
                @if (!string.IsNullOrEmpty(item.Description))
                {
                    <p>@item.Description</p>
                }
                @if (!string.IsNullOrEmpty(item.Category))
                {
                    <span class="badge bg-primary bg-opacity-10 text-primary mt-1">@item.Category</span>
                }
            </div>
        </div>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-camera fa-3x text-muted mb-3 d-block"></i>
        <h4 class="text-muted">Galeri yakında açılacak</h4>
        <p class="text-muted">Projelerimizden görüntüler yakında burada olacak.</p>
    </div>
}

<!-- Lightbox -->
<div class="lightbox-overlay" id="lightbox">
    <button class="lightbox-close" id="lightboxClose">&times;</button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev"><i class="fas fa-chevron-left"></i></button>
    <div class="lightbox-content" id="lightboxContent"></div>
    <button class="lightbox-nav lightbox-next" id="lightboxNext"><i class="fas fa-chevron-right"></i></button>
</div>

@section Scripts {
<script>
(function() {
    // Filter
    var filterBtns = document.querySelectorAll('.gallery-filters .btn');
    var cards = document.querySelectorAll('.gallery-card');
    filterBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
            filterBtns.forEach(function(b) { b.classList.remove('active'); b.classList.replace('btn-primary','btn-outline-primary'); });
            btn.classList.add('active');
            btn.classList.replace('btn-outline-primary','btn-primary');
            var filter = btn.getAttribute('data-filter');
            cards.forEach(function(card) {
                if (filter === 'all' || card.getAttribute('data-category') === filter) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    });

    // Lightbox
    var lightbox = document.getElementById('lightbox');
    var content = document.getElementById('lightboxContent');
    var currentIndex = -1;
    var visibleCards = function() {
        return Array.from(cards).filter(function(c) { return c.style.display !== 'none'; });
    };

    function openLightbox(index) {
        var items = visibleCards();
        if (index < 0 || index >= items.length) return;
        currentIndex = index;
        var card = items[index];
        var type = card.getAttribute('data-type');
        var src = card.getAttribute('data-src');
        var title = card.getAttribute('data-title');
        var desc = card.getAttribute('data-desc');

        var html = '';
        if (type === 'video') {
            html = '<video controls autoplay style="max-width:90vw;max-height:85vh;border-radius:0.75rem;"><source src="' + src + '"></video>';
        } else {
            html = '<img src="' + src + '" alt="' + title + '">';
        }
        html += '<div class="lightbox-caption">' + title;
        if (desc) html += '<br><small style="opacity:0.7">' + desc + '</small>';
        html += '</div>';
        content.innerHTML = html;
        lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    cards.forEach(function(card, i) {
        card.addEventListener('click', function() {
            var items = visibleCards();
            var idx = items.indexOf(card);
            openLightbox(idx);
        });
    });

    document.getElementById('lightboxClose').addEventListener('click', function() {
        lightbox.classList.remove('active');
        content.innerHTML = '';
        document.body.style.overflow = '';
    });
    lightbox.addEventListener('click', function(e) {
        if (e.target === lightbox) {
            lightbox.classList.remove('active');
            content.innerHTML = '';
            document.body.style.overflow = '';
        }
    });
    document.getElementById('lightboxPrev').addEventListener('click', function(e) {
        e.stopPropagation();
        if (currentIndex > 0) openLightbox(currentIndex - 1);
    });
    document.getElementById('lightboxNext').addEventListener('click', function(e) {
        e.stopPropagation();
        var items = visibleCards();
        if (currentIndex < items.length - 1) openLightbox(currentIndex + 1);
    });
    document.addEventListener('keydown', function(e) {
        if (!lightbox.classList.contains('active')) return;
        if (e.key === 'Escape') { lightbox.classList.remove('active'); content.innerHTML = ''; document.body.style.overflow = ''; }
        if (e.key === 'ArrowLeft' && currentIndex > 0) openLightbox(currentIndex - 1);
        if (e.key === 'ArrowRight') { var items = visibleCards(); if (currentIndex < items.length - 1) openLightbox(currentIndex + 1); }
    });

    // Video hover play on cards
    cards.forEach(function(card) {
        if (card.getAttribute('data-type') === 'video') {
            var vid = card.querySelector('video');
            if (vid) {
                card.addEventListener('mouseenter', function() { vid.play().catch(function(){}); });
                card.addEventListener('mouseleave', function() { vid.pause(); vid.currentTime = 0; });
            }
        }
    });
})();
</script>
}
