                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-banner\'\x3e\x3cspan class=\'brand-name\'\x3eBANNER\x3c/span\x3e\x3c/div\x3e'" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="SICK"
                         src="~/images/brands/sick.png"
                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-sick\'\x3e\x3cspan class=\'brand-name\'\x3eSICK\x3c/span\x3e\x3c/div\x3e'" />
                </div>
