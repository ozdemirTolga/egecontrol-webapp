@page
@model IndexModel
@{
    ViewData["Title"] = "Ege Otomasyon - Endüstriyel Otomasyon Çözümleri";
    ViewData["MetaDescription"] = "Ege Otomasyon - İzmir merkezli endüstriyel otomasyon firması. PLC programlama, SCADA sistemleri, robotik otomasyon, HMI panel tasarımı, servo motor sürücü ve teknik destek hizmetleri.";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <div class="hero-content">
                    <span class="section-badge">Endüstriyel Otomasyon</span>
                    <h1 class="hero-title">
                        <span class="text-primary">Endüstriyel</span><br>
                        <span class="text-dark">Otomasyon</span><br>
                        <span class="text-secondary">Çözümleri</span>
                    </h1>
                    <p class="hero-subtitle">
                        Modern teknoloji ile endüstrinizi geleceğe taşıyoruz. 
                        PLC programlama, SCADA sistemleri, robotik otomasyon ve daha fazlası...
                    </p>
                    <div class="hero-buttons">
                        <a href="#services" class="btn btn-primary btn-lg me-3">
                            <i class="fas fa-cogs me-2"></i>Hizmetlerimiz
                        </a>
                        <a href="#contact" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-envelope me-2"></i>İletişim
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-animation">
                    <svg width="500" height="400" viewBox="0 0 500 400" class="factory-svg">
                        <!-- Background Grid -->
                        <defs>
                            <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#2563eb;stop-opacity:0.15" />
                                <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:0.05" />
                            </linearGradient>
                            <linearGradient id="grad2" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" style="stop-color:#2563eb;stop-opacity:0.9" />
                                <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:0.9" />
                            </linearGradient>
                        </defs>
                        
                        <!-- Circuit Board Pattern -->
                        <rect x="40" y="40" width="420" height="320" rx="20" fill="url(#grad1)" />
                        
                        <!-- Factory Buildings -->
                        <rect x="80" y="180" width="90" height="120" rx="4" fill="#2563eb" opacity="0.85">
                            <animate attributeName="opacity" values="0.7;0.95;0.7" dur="3s" repeatCount="indefinite"/>
                        </rect>
                        <rect x="180" y="150" width="70" height="150" rx="4" fill="#1d4ed8" opacity="0.85">
                            <animate attributeName="opacity" values="0.8;1;0.8" dur="2.5s" repeatCount="indefinite"/>
                        </rect>
                        <rect x="260" y="170" width="80" height="130" rx="4" fill="#3b82f6" opacity="0.85">
                            <animate attributeName="opacity" values="0.75;0.95;0.75" dur="2.8s" repeatCount="indefinite"/>
                        </rect>
                        <rect x="350" y="190" width="60" height="110" rx="4" fill="#06b6d4" opacity="0.85">
                            <animate attributeName="opacity" values="0.7;0.9;0.7" dur="2.2s" repeatCount="indefinite"/>
                        </rect>
                        
                        <!-- Smokestacks -->
                        <rect x="100" y="130" width="12" height="50" rx="2" fill="#475569"/>
                        <rect x="200" y="110" width="12" height="40" rx="2" fill="#475569"/>
                        <rect x="290" y="120" width="12" height="50" rx="2" fill="#475569"/>
                        
                        <!-- Smoke Particles -->
                        <circle r="4" fill="#94a3b8" opacity="0.5">
                            <animate attributeName="cx" values="106;98;110" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="125;90;55" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="0.5;0.2;0" dur="3s" repeatCount="indefinite"/>
                            <animate attributeName="r" values="4;8;12" dur="3s" repeatCount="indefinite"/>
                        </circle>
                        <circle r="3" fill="#94a3b8" opacity="0.4">
                            <animate attributeName="cx" values="206;200;212" dur="2.5s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="105;75;45" dur="2.5s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="0.4;0.15;0" dur="2.5s" repeatCount="indefinite"/>
                            <animate attributeName="r" values="3;6;10" dur="2.5s" repeatCount="indefinite"/>
                        </circle>
                        <circle r="3.5" fill="#94a3b8" opacity="0.45">
                            <animate attributeName="cx" values="296;290;302" dur="2.8s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="115;80;50" dur="2.8s" repeatCount="indefinite"/>
                            <animate attributeName="opacity" values="0.45;0.15;0" dur="2.8s" repeatCount="indefinite"/>
                            <animate attributeName="r" values="3.5;7;11" dur="2.8s" repeatCount="indefinite"/>
                        </circle>
                        
                        <!-- Conveyor Belt -->
                        <rect x="60" y="300" width="380" height="8" rx="4" fill="url(#grad2)" opacity="0.3"/>
                        <circle r="5" fill="#f59e0b">
                            <animate attributeName="cx" values="80;420;80" dur="5s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="304;304;304" dur="5s" repeatCount="indefinite"/>
                        </circle>
                        <circle r="5" fill="#10b981">
                            <animate attributeName="cx" values="200;420;80;200" dur="5s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="304;304;304;304" dur="5s" repeatCount="indefinite"/>
                        </circle>
                        <circle r="5" fill="#06b6d4">
                            <animate attributeName="cx" values="340;420;80;340" dur="5s" repeatCount="indefinite"/>
                            <animate attributeName="cy" values="304;304;304;304" dur="5s" repeatCount="indefinite"/>
                        </circle>
                        
                        <!-- Connection Lines (circuit style) -->
                        <line x1="170" y1="240" x2="180" y2="240" stroke="#2563eb" stroke-width="2" opacity="0.3">
                            <animate attributeName="opacity" values="0.3;0.8;0.3" dur="1.5s" repeatCount="indefinite"/>
                        </line>
                        <line x1="250" y1="220" x2="260" y2="220" stroke="#06b6d4" stroke-width="2" opacity="0.3">
                            <animate attributeName="opacity" values="0.3;0.8;0.3" dur="1.8s" repeatCount="indefinite"/>
                        </line>
                        <line x1="340" y1="230" x2="350" y2="230" stroke="#2563eb" stroke-width="2" opacity="0.3">
                            <animate attributeName="opacity" values="0.3;0.8;0.3" dur="1.3s" repeatCount="indefinite"/>
                        </line>
                        
                        <!-- Gear Icon -->
                        <g transform="translate(390, 80)">
                            <circle cx="0" cy="0" r="18" fill="none" stroke="#2563eb" stroke-width="2" opacity="0.3"/>
                            <circle cx="0" cy="0" r="6" fill="#2563eb" opacity="0.4">
                                <animateTransform attributeName="transform" type="rotate" values="0;360" dur="8s" repeatCount="indefinite"/>
                            </circle>
                        </g>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Services Section -->
<section id="services" class="services-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5 reveal">
                <span class="section-badge">Ne Yapıyoruz</span>
                <h2 class="section-title">Hizmetlerimiz</h2>
                <p class="section-subtitle">Endüstriyel otomasyon alanında sunduğumuz profesyonel çözümler</p>
            </div>
        </div>
        <div class="row g-4 reveal-stagger">
            <!-- PLC Programming -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                            <rect x="6" y="7" width="3" height="3" fill="currentColor"/>
                            <rect x="10" y="7" width="3" height="3" fill="currentColor"/>
                            <rect x="14" y="7" width="3" height="3" fill="currentColor"/>
                            <rect x="6" y="11" width="3" height="3" fill="currentColor"/>
                            <rect x="10" y="11" width="3" height="3" fill="currentColor"/>
                            <rect x="14" y="11" width="3" height="3" fill="currentColor"/>
                            <rect x="6" y="15" width="3" height="3" fill="currentColor"/>
                            <rect x="10" y="15" width="3" height="3" fill="currentColor"/>
                            <rect x="14" y="15" width="3" height="3" fill="currentColor"/>
                        </svg>
                    </div>
                    <h4>PLC Programlama</h4>
                    <p>Siemens, Allen Bradley, Schneider ve diğer markalar için profesyonel PLC programlama hizmetleri.</p>
                </div>
            </div>
            
            <!-- SCADA Systems -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="2" y="3" width="20" height="14" rx="2" stroke="currentColor" stroke-width="2" fill="none"/>
                            <line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="2"/>
                            <line x1="12" y1="17" x2="12" y2="21" stroke="currentColor" stroke-width="2"/>
                            <circle cx="7" cy="9" r="2" stroke="currentColor" stroke-width="2"/>
                            <path d="M17 7l-3 3-2-2-4 4" stroke="currentColor" stroke-width="2" fill="none"/>
                        </svg>
                    </div>
                    <h4>SCADA Sistemleri</h4>
                    <p>Endüstriyel süreçlerinizi izlemek ve kontrol etmek için gelişmiş SCADA çözümleri.</p>
                </div>
            </div>
            
            <!-- Industrial Robotics -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="4" y="6" width="16" height="4" rx="2" stroke="currentColor" stroke-width="2"/>
                            <rect x="4" y="2" width="16" height="2" rx="1" fill="currentColor"/>
                            <rect x="8" y="12" width="2" height="8" stroke="currentColor" stroke-width="2"/>
                            <rect x="14" y="12" width="2" height="8" stroke="currentColor" stroke-width="2"/>
                            <circle cx="9" cy="22" r="2" stroke="currentColor" stroke-width="2"/>
                            <circle cx="15" cy="22" r="2" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h4>Endüstriyel Robotik</h4>
                    <p>Robotik otomasyon sistemleri ile üretim verimliliğinizi maksimuma çıkarın.</p>
                </div>
            </div>
            
            <!-- Process Automation -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
                            <circle cx="12" cy="4" r="2" fill="currentColor"/>
                            <circle cx="20" cy="12" r="2" fill="currentColor"/>
                            <circle cx="12" cy="20" r="2" fill="currentColor"/>
                            <circle cx="4" cy="12" r="2" fill="currentColor"/>
                            <line x1="12" y1="6" x2="12" y2="9" stroke="currentColor" stroke-width="2"/>
                            <line x1="18" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="2"/>
                            <line x1="12" y1="18" x2="12" y2="15" stroke="currentColor" stroke-width="2"/>
                            <line x1="6" y1="12" x2="9" y2="12" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h4>Süreç Otomasyonu</h4>
                    <p>Endüstriyel süreçlerinizi optimize eden akıllı otomasyon çözümleri.</p>
                </div>
            </div>
            
            <!-- HMI Development -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="4" width="18" height="12" rx="1" stroke="currentColor" stroke-width="2"/>
                            <rect x="6" y="7" width="4" height="3" fill="currentColor"/>
                            <rect x="11" y="7" width="6" height="1" fill="currentColor"/>
                            <rect x="11" y="9" width="4" height="1" fill="currentColor"/>
                            <rect x="6" y="11" width="8" height="1" fill="currentColor"/>
                            <rect x="6" y="13" width="6" height="1" fill="currentColor"/>
                            <line x1="8" y1="16" x2="16" y2="16" stroke="currentColor" stroke-width="2"/>
                            <line x1="12" y1="20" x2="12" y2="16" stroke="currentColor" stroke-width="2"/>
                        </svg>
                    </div>
                    <h4>HMI Geliştirme</h4>
                    <p>Kullanıcı dostu arayüzler ile operatör deneyimini geliştirelim.</p>
                </div>
            </div>
            
            <!-- Technical Support -->
            <div class="col-md-6 col-lg-4">
                <div class="service-card">
                    <div class="service-icon">
                        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" fill="none"/>
                            <path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z" stroke="currentColor" stroke-width="2" fill="none"/>
                        </svg>
                    </div>
                    <h4>Teknik Destek</h4>
                    <p>7/24 teknik destek ile sistemlerinizin kesintisiz çalışmasını sağlıyoruz.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Statistics Section -->
<section class="stats-section section-padding">
    <div class="container">
        <div class="row text-center reveal-stagger">
            <div class="col-md-3 col-6 mb-4">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-project-diagram"></i></div>
                    <h3 class="stat-number" data-target="@Model.StatProjects">0</h3>
                    <p class="stat-label">Tamamlanan Proje</p>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-4">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-smile"></i></div>
                    <h3 class="stat-number" data-target="@Model.StatCustomers">0</h3>
                    <p class="stat-label">Mutlu Müşteri</p>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-4">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-award"></i></div>
                    <h3 class="stat-number" data-target="@Model.StatExperience">0</h3>
                    <p class="stat-label">Yıllık Deneyim</p>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-4">
                <div class="stat-item">
                    <div class="stat-icon"><i class="fas fa-headset"></i></div>
                    <h3 class="stat-number" data-target="@Model.StatSupport">0</h3>
                    <p class="stat-label">Saat Teknik Destek</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Technologies Section -->
<section class="tech-section section-padding">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-5 reveal">
                <span class="section-badge">Güvenilir Markalar</span>
                <h2 class="section-title">Kullandığımız Teknolojiler</h2>
                <p class="section-subtitle">Sektörün lideri markalarıyla çalışıyoruz</p>
            </div>
        </div>
        <div class="row align-items-center justify-content-center reveal-stagger">
            <!-- Row 1: Siemens, ABB, Allen Bradley, Schneider, Omron, Delta -->
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img size-lg" alt="Siemens"
                         src="~/images/brands/siemens.svg"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/5/5f/Siemens-logo.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-siemens\'\x3e\x3cspan class=\'brand-name\'\x3eSIEMENS\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="ABB"
                         src="~/images/brands/abb.svg"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/0/00/ABB_logo.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-abb\'\x3e\x3cspan class=\'brand-name\'\x3eABB\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img size-2x" alt="Allen Bradley"
                         src="~/images/brands/allen-Bradley.webp"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/a/a7/Allen-Bradley_logo.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-ab\'\x3e\x3cspan class=\'brand-name\'\x3eALLEN BRADLEY\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img size-xl size-2x" alt="Schneider Electric"
                         src="~/images/brands/schneider.png"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/6/6b/Schneider_Electric.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-schneider\'\x3e\x3cspan class=\'brand-name\'\x3eSCHNEIDER\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img size-xl size-2x" alt="Omron"
                         src="~/images/brands/omron.png"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/b/b8/OMRON_LOGO.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-omron\'\x3e\x3cspan class=\'brand-name\'\x3eOMRON\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="Delta"
                         src="~/images/brands/Delta.svg"
                         data-fallback="https://upload.wikimedia.org/wikipedia/commons/e/eb/Delta_Electronics_Logo.svg"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-delta\'\x3e\x3cspan class=\'brand-name\'\x3eDELTA\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <!-- Row 2: Inovance, KUKA, FANUC, Danfoss, Lenze, GMT -->
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img size-2x" alt="Inovance"
                         src="~/images/brands/inovance.jpg"
                         data-fallback="https://www.inovance.com/static/images/logo.png"
                         onerror="if(this.dataset.stage!=='1'){this.dataset.stage='1';this.src='~/images/brands/inovance.png';}else if(this.dataset.stage!=='2'){this.dataset.stage='2';this.src=this.dataset.fallback;}else{this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-inovance\'\x3e\x3cspan class=\'brand-name\'\x3eINOVANCE\x3c/span\x3e\x3c/div\x3e'}" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="KUKA"
                         src="~/images/brands/kuka.png"
                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-kuka\'\x3e\x3cspan class=\'brand-name\'\x3eKUKA\x3c/span\x3e\x3c/div\x3e'" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="FANUC"
                         src="~/images/brands/fanuc.png"
                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-fanuc\'\x3e\x3cspan class=\'brand-name\'\x3eFANUC\x3c/span\x3e\x3c/div\x3e'" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="Danfoss"
                         src="~/images/brands/danfoss.png"
                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-danfoss\'\x3e\x3cspan class=\'brand-name\'\x3eDANFOSS\x3c/span\x3e\x3c/div\x3e'" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="Lenze"
                         src="~/images/brands/lenze.svg"
                         onerror="this.parentElement.outerHTML='\x3cdiv class=\'tech-logo tech-lenze\'\x3e\x3cspan class=\'brand-name\'\x3eLENZE\x3c/span\x3e\x3c/div\x3e'" />
                </div>
            </div>
            <div class="col-lg-2 col-md-3 col-4 text-center mb-4">
                <div class="tech-logo-img">
                    <img class="brand-img" alt="GMT"
                         src="~/images/brands/gmt.svg"
